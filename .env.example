# Optional. Without a key everything still runs; rationale, briefings and Q&A fall back to the rules engine.
ANTHROPIC_API_KEY=
# Model and reasoning effort (low | medium | high | xhigh | max) used by the agent.
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=medium
# Industry pack loaded on first start: pharmacy or logistics. The console can switch packs at any time.
TOWER_DOMAIN=pharmacy
# SQLite file location
SANAR_DB=sanar.db
